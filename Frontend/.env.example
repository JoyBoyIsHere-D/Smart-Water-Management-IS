# API Configuration
# For local dev:    VITE_API_URL=http://localhost:5000
# For Docker:       VITE_API_URL=http://localhost:5000   (same — ports are exposed)
# For production:   VITE_API_URL=https://your-server-ip-or-domain:5000
# NOTE: This is baked in at build time. Rebuild the frontend container if you change it.
VITE_API_URL=http://localhost:5000
