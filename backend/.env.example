# PostgreSQL Configuration
# Format: postgresql://user:password@host:port/dbname
# For local dev:   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/water_management
# For Docker:      DATABASE_URL=postgresql://wateradmin:changeme@db:5432/water_management
#                  (docker-compose overrides this automatically — 'db' = postgres container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/water_management

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,https://smart-water-management-is.vercel.app

# Client Server Configuration
CLIENT_ID=client_1
CLIENT_HOST=0.0.0.0
CLIENT_PORT=5001
DATA_FILE=data/synthetic_dataset.csv

# Optional: separate CORS list for client server only
# CLIENT_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000
