# Root .env — used by docker-compose for shared variables
# Copy this to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=wateradmin
DB_PASSWORD=changeme_strong_password
DB_NAME=water_management

# ─── Host Ports (change these on systems where defaults are busy) ──────────
FRONTEND_HOST_PORT=3000
BACKEND_ADMIN_HOST_PORT=5000
BACKEND_CLIENT_HOST_PORT=5001
DB_HOST_PORT=5432
